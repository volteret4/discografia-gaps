# Copia este fichero a .env y rellénalo. Los valores vacíos son obligatorios u opcionales según el README.

# Versión de API Subsonic a declarar (ej. 1.15.0)
AIRSONIC_API_VERSION=
# Contraseña Airsonic
AIRSONIC_PASSWORD=
# URL base de Airsonic
AIRSONIC_URL=http://localhost:4040
# Usuario Airsonic
AIRSONIC_USER=admin
# Ruta host donde qBittorrent guarda las descargas (bind mount — requiere recrear el contenedor)
DISCOGRAFIA_GAPS_QB_MUSIC_PATH=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# API key de Last.fm — solo hace falta si NO hay espejo compartido (lastfm_data) montado
LASTFM_API_KEY=
# Umbral de scrobbles para AÑADIR artistas al universo desde Last.fm — 0 desactiva este filtro
LASTFM_MIN_PLAYCOUNT=0
LASTFM_SCROBBLES_DB=/data/lastfm_stats.db
# Usuario de Last.fm
LASTFM_USERNAME=
# Email de contacto para la API de MusicBrainz (lo piden en el User-Agent)
MB_EMAIL=admin@localhost
# Contraseña de Muspy
MUSPY_PASSWORD=
# Usuario de Muspy
MUSPY_USERNAME=
# API key de Orpheus.network
ORPHEUS_APIKEY=
# Categoria de qBittorrent a escanear para 'have' (vacio = todas)
QB_CATEGORY=
# Categoria con la que se añaden en qBittorrent los torrents descargados desde aqui (vacio = sin categoria)
QB_DOWNLOAD_CATEGORY=
# Host/IP de qBittorrent
QB_HOST=localhost
# Contraseña WebUI de qBittorrent
QB_PASS=
# Puerto WebUI de qBittorrent
QB_PORT=8080
# Solo si qBittorrent corre en SU PROPIO contenedor: ruta tal cual la reporta su API
QB_REMOTE_PATH=
# Usuario WebUI de qBittorrent
QB_USER=admin
SETTINGS_PASSWORD=
